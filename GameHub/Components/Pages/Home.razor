@page "/"

<PageTitle>بازی شیاد</PageTitle>

<div class="page-stack">
    <div class="game-card hero-card">
        <div class="hero-badge-glow">
            <img src="/Icons/mask.png" alt="بازی شیاد" />
        </div>

        <h1 class="hero-title">بازی شیاد</h1>
        <p class="hero-subtitle">
            دورهمی، هیجان و بلوف! شیاد را بین دوستانتان پیدا کنید قبل از اینکه کلمه مخفی را حدس بزند.
        </p>

        <div class="hero-stats-row">
            <span class="hero-stat-pill">📚 ۸ دسته‌بندی</span>
            <span class="hero-stat-pill">🎯 ۳ سطح سختی</span>
            <span class="hero-stat-pill">✨ ۳۳۱ کلمه</span>
        </div>

        <div class="action-stack" style="margin-top:6px;">
            <button type="button" class="primary-action-btn" @onclick="GoToGame">
                🎭 شروع بازی شیاد
            </button>

            <div class="two-col-actions">
                <button type="button" class="secondary-action-btn" @onclick="OpenSettings">
                    ⚙️ تنظیمات
                </button>

                <button type="button" class="secondary-action-btn" @onclick="GoToAbout">
                    📖 راهنما
                </button>
            </div>
        </div>
    </div>
</div>
