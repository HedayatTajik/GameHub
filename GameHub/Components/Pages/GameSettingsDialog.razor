@inherits ImposterGame.Pages.GameSettingsDialog
@using ImposterGame.Models

<div class="settings-dialog-body">
    <!-- Difficulty Level -->
    <section class="settings-section">
        <div class="settings-section-title">🎯 سطح بازی</div>
        <div class="difficulty-control">
            <button type="button"
                    class="difficulty-btn easy @(Settings.Difficulty == WordDifficulty.Easy ? "active" : string.Empty)"
                    @onclick="() => SetDifficulty(WordDifficulty.Easy)">
                🟢 آسان
            </button>
            <button type="button"
                    class="difficulty-btn medium @(Settings.Difficulty == WordDifficulty.Medium ? "active" : string.Empty)"
                    @onclick="() => SetDifficulty(WordDifficulty.Medium)">
                🟡 متوسط
            </button>
            <button type="button"
                    class="difficulty-btn hard @(Settings.Difficulty == WordDifficulty.Hard ? "active" : string.Empty)"
                    @onclick="() => SetDifficulty(WordDifficulty.Hard)">
                🔴 سخت
            </button>
        </div>
        <div class="settings-hint">@DifficultyDescription</div>
    </section>

    <!-- Word Categories -->
    <section class="settings-section">
        <div class="settings-section-header">
            <span class="settings-section-title">📚 دسته‌بندی کلمات</span>
            <span class="pill-badge">@ActiveWordCount کلمه</span>
        </div>

        <div class="category-chips">
            @{
                var allSelected = Settings.SelectedCategoryIds.Count == 0;
            }
            <button type="button"
                    class="chip-btn @(allSelected ? "active" : string.Empty)"
                    @onclick="SelectAllCategories">
                ✨ همه دسته‌ها
            </button>

            @foreach (var category in Categories)
            {
                var isSelected = IsCategorySelected(category.Id);
                var levelWordCount = category.GetWords(Settings.Difficulty).Count;
                <button type="button"
                        class="chip-btn @(isSelected ? "active" : string.Empty)"
                        @onclick="() => ToggleCategory(category.Id)">
                    @category.Icon @category.Name
                    <span class="chip-count">@levelWordCount</span>
                </button>
            }
        </div>
    </section>

    <!-- Imposter Count -->
    <section class="settings-section">
        <div class="settings-section-title">🕵️ تعداد شیادها</div>
        <div class="segmented-control">
            <button type="button"
                    class="segment-btn @(EffectiveImposterCount == 1 ? "active" : string.Empty)"
                    @onclick="() => SetImposterCount(1)">
                ۱ شیاد
            </button>
            <button type="button"
                    class="segment-btn @(EffectiveImposterCount == 2 ? "active" : string.Empty)"
                    disabled="@(!CanUseTwoImposters)"
                    @onclick="() => SetImposterCount(2)">
                ۲ شیاد
            </button>
        </div>
        @if (!CanUseTwoImposters)
        {
            <div class="settings-hint">
                برای انتخاب ۲ شیاد حداقل @ImposterGame.Services.GameService.MinPlayersForTwoImposters بازیکن لازم است.
            </div>
        }
    </section>

    <!-- Round Duration -->
    <section class="settings-section">
        <div class="settings-toggle-row">
            <div>
                <div class="settings-section-title">⏱️ زمان خودکار</div>
                <div class="settings-hint">۱ دقیقه به ازای هر بازیکن</div>
            </div>
            <RadzenSwitch Value="@Settings.AutoTimePerPlayer" ValueChanged="@OnAutoTimeChanged" />
        </div>

        @if (!Settings.AutoTimePerPlayer)
        {
            <div class="stepper-row">
                <button type="button"
                        class="stepper-btn"
                        disabled="@(Settings.RoundDurationMinutes <= ImposterGame.Services.GameService.MinRoundMinutes)"
                        @onclick="() => ChangeRoundMinutes(-1)">
                    −
                </button>
                <span class="stepper-value">@Settings.RoundDurationMinutes دقیقه</span>
                <button type="button"
                        class="stepper-btn"
                        disabled="@(Settings.RoundDurationMinutes >= ImposterGame.Services.GameService.MaxRoundMinutes)"
                        @onclick="() => ChangeRoundMinutes(1)">
                    +
                </button>
            </div>
        }
    </section>

    <!-- Category Hint for Imposter -->
    <section class="settings-section">
        <div class="settings-toggle-row">
            <div>
                <div class="settings-section-title">💡 راهنمایی برای شیاد</div>
                <div class="settings-hint">شیاد فقط نام دسته‌بندی کلمه را می‌بیند</div>
            </div>
            <RadzenSwitch Value="@Settings.ShowCategoryHintToImposter" ValueChanged="@OnCategoryHintChanged" />
        </div>
    </section>

    <!-- Done Button -->
    <button type="button" class="primary-action-btn" @onclick="CloseDialog">
        ✓ تأیید و بستن
    </button>
</div>
