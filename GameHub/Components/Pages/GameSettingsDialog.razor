@inherits ImposterGame.Pages.GameSettingsDialog
@using ImposterGame.Models

<div class="settings-dialog-body">
    <!-- Language Selection -->
    <section class="settings-section">
        <div class="settings-section-title">@L.SettingsLanguageTitle</div>
        <div class="language-control">
            <button type="button"
                    class="lang-btn @(Settings.Language == "fa" ? "active" : string.Empty)"
                    @onclick='() => SetLanguage("fa")'>
                🇮🇷 فارسی
            </button>
            <button type="button"
                    class="lang-btn @(Settings.Language == "de" ? "active" : string.Empty)"
                    @onclick='() => SetLanguage("de")'>
                🇩🇪 Deutsch
            </button>
            <button type="button"
                    class="lang-btn @(Settings.Language == "en" ? "active" : string.Empty)"
                    @onclick='() => SetLanguage("en")'>
                🇬🇧 English
            </button>
        </div>
    </section>

    <!-- Appearance & Audio/Haptics -->
    <section class="settings-section">
        <div class="settings-toggle-row">
            <div>
                <div class="settings-section-title">@L.SettingsAppearanceTitle</div>
                <div class="settings-hint">@L.SettingsAppearanceHint</div>
            </div>
            <RadzenSwitch Value="@Settings.DarkMode" ValueChanged="@OnDarkModeChanged" />
        </div>

        <div class="settings-divider"></div>

        <div class="settings-toggle-row">
            <div>
                <div class="settings-section-title">@L.SettingsSoundTitle</div>
                <div class="settings-hint">@L.SettingsSoundHint</div>
            </div>
            <RadzenSwitch Value="@Settings.SoundEnabled" ValueChanged="@OnSoundChanged" />
        </div>
    </section>

    <!-- Difficulty Level -->
    <section class="settings-section">
        <div class="settings-section-title">@L.SettingsDifficultyTitle</div>
        <div class="difficulty-control">
            <button type="button"
                    class="difficulty-btn easy @(Settings.Difficulty == WordDifficulty.Easy ? "active" : string.Empty)"
                    @onclick="() => SetDifficulty(WordDifficulty.Easy)">
                @L.DifficultyLabel(WordDifficulty.Easy)
            </button>
            <button type="button"
                    class="difficulty-btn medium @(Settings.Difficulty == WordDifficulty.Medium ? "active" : string.Empty)"
                    @onclick="() => SetDifficulty(WordDifficulty.Medium)">
                @L.DifficultyLabel(WordDifficulty.Medium)
            </button>
            <button type="button"
                    class="difficulty-btn hard @(Settings.Difficulty == WordDifficulty.Hard ? "active" : string.Empty)"
                    @onclick="() => SetDifficulty(WordDifficulty.Hard)">
                @L.DifficultyLabel(WordDifficulty.Hard)
            </button>
        </div>
        <div class="settings-hint">@L.DifficultyDescription(Settings.Difficulty)</div>
    </section>

    <!-- Word Categories -->
    <section class="settings-section">
        <div class="settings-section-header">
            <span class="settings-section-title">@L.SettingsCategoriesTitle</span>
            <span class="pill-badge">@L.WordsCountPill(ActiveWordCount)</span>
        </div>

        <div class="category-chips">
            @{
                var allSelected = Settings.SelectedCategoryIds.Count == 0;
            }
            <button type="button"
                    class="chip-btn @(allSelected ? "active" : string.Empty)"
                    @onclick="SelectAllCategories">
                @L.AllCategoriesChip
            </button>

            @foreach (var category in Categories)
            {
                var isSelected = IsCategorySelected(category.Id);
                var levelWordCount = category.GetWords(Settings.Difficulty).Count;
                <button type="button"
                        class="chip-btn @(isSelected ? "active" : string.Empty)"
                        @onclick="() => ToggleCategory(category.Id)">
                    @category.Icon @category.Name
                    <span class="chip-count">@levelWordCount</span>
                </button>
            }
        </div>
    </section>

    <!-- Imposter Count -->
    <section class="settings-section">
        <div class="settings-section-title">@L.SettingsImpostersTitle</div>
        <div class="segmented-control">
            <button type="button"
                    class="segment-btn @(EffectiveImposterCount == 1 ? "active" : string.Empty)"
                    @onclick="() => SetImposterCount(1)">
                @L.ImposterOption(1)
            </button>
            <button type="button"
                    class="segment-btn @(EffectiveImposterCount == 2 ? "active" : string.Empty)"
                    disabled="@(!CanUseTwoImposters)"
                    @onclick="() => SetImposterCount(2)">
                @L.ImposterOption(2)
            </button>
        </div>
        @if (!CanUseTwoImposters)
        {
            <div class="settings-hint">
                @L.TwoImpostersHint(ImposterGame.Services.GameService.MinPlayersForTwoImposters)
            </div>
        }
    </section>

    <!-- Round Duration -->
    <section class="settings-section">
        <div class="settings-toggle-row">
            <div>
                <div class="settings-section-title">@L.SettingsAutoTimeTitle</div>
                <div class="settings-hint">@L.SettingsAutoTimeHint</div>
            </div>
            <RadzenSwitch Value="@Settings.AutoTimePerPlayer" ValueChanged="@OnAutoTimeChanged" />
        </div>

        @if (!Settings.AutoTimePerPlayer)
        {
            <div class="stepper-row">
                <button type="button"
                        class="stepper-btn"
                        disabled="@(Settings.RoundDurationMinutes <= ImposterGame.Services.GameService.MinRoundMinutes)"
                        @onclick="() => ChangeRoundMinutes(-1)">
                    −
                </button>
                <span class="stepper-value">@L.MinutesLabel(Settings.RoundDurationMinutes)</span>
                <button type="button"
                        class="stepper-btn"
                        disabled="@(Settings.RoundDurationMinutes >= ImposterGame.Services.GameService.MaxRoundMinutes)"
                        @onclick="() => ChangeRoundMinutes(1)">
                    +
                </button>
            </div>
        }
    </section>

    <!-- Category Hint for Imposter -->
    <section class="settings-section">
        <div class="settings-toggle-row">
            <div>
                <div class="settings-section-title">@L.SettingsHintTitle</div>
                <div class="settings-hint">@L.SettingsHintDesc</div>
            </div>
            <RadzenSwitch Value="@Settings.ShowCategoryHintToImposter" ValueChanged="@OnCategoryHintChanged" />
        </div>
    </section>

    @if (CanInstallPwa)
    {
        <button type="button" class="soft-action-btn" @onclick="InstallApp">
            @L.InstallAppButton
        </button>
    }
    else if (ShowIosInstallHint)
    {
        <div class="settings-section">
            <div class="settings-hint">@L.IosInstallHint</div>
        </div>
    }
    else if (!IsStandalone)
    {
        <div class="settings-section">
            <div class="settings-hint">@L.BrowserInstallHint</div>
        </div>
    }

    <!-- Done Button -->
    <button type="button" class="primary-action-btn" @onclick="CloseDialog">
        @L.SaveAndCloseButton
    </button>

    <button type="button" class="ghost-action-btn" @onclick="OpenPrivacyPage">
        @L.PrivacyPolicyLink
    </button>
</div>
