@page "/timer"
@inherits ImposterGame.Pages.Timer
<PageTitle>@L.TimerPageTitle</PageTitle>

<NavigationLock ConfirmExternalNavigation="@ShouldConfirmExit"
                OnBeforeInternalNavigation="@HandleBeforeInternalNavigation" />

<div class="page-stack">
    <div class="game-card timer-card">
        @if (!string.IsNullOrEmpty(PersonStart))
        {
            <div class="starter-badge">@L.StartsFirst(PersonStart)</div>
        }

        @if (Imposters.Count > 1)
        {
            <div class="multi-imposter-badge">@L.MultiImposterBadge(Imposters.Count)</div>
        }

        <!-- Circular Countdown Ring -->
        <div class="timer-ring-wrap @(IsTimeUp ? "time-up" : string.Empty)">
            <svg class="timer-ring-svg" viewBox="0 0 210 210" aria-hidden="true">
                <circle class="timer-ring-bg" cx="105" cy="105" r="92" />
                <circle class="timer-ring-progress @TimerRingStateClass"
                        cx="105"
                        cy="105"
                        r="92"
                        stroke-dasharray="@RingCircumferenceCss"
                        stroke-dashoffset="@RingDashOffsetCss" />
            </svg>
            <div class="timer-ring-center">
                <div class="timer-display @(IsTimeUp ? "time-up" : string.Empty)">@formattedTime</div>
                <div class="timer-status-label">@TimerStatusLabel</div>
            </div>
        </div>

        @if (IsTimeUp)
        {
            <div class="time-up-banner">@L.TimeUpBanner</div>
        }

        <div class="action-stack">
            @if (!IsTimeUp && !showResult)
            {
                <div class="two-col-actions">
                    <button type="button" class="secondary-action-btn" @onclick="TogglePause">
                        @(isPaused ? L.ResumeButton : L.PauseButton)
                    </button>

                    @if (Imposters.Count > 0)
                    {
                        <button type="button" class="soft-action-btn" @onclick="RevealResult">
                            @L.RevealResultShort
                        </button>
                    }
                </div>
            }
            else if (Imposters.Count > 0 && !showResult)
            {
                <button type="button" class="coral-action-btn" @onclick="RevealResult">
                    @L.RevealResultFull(Imposters.Count)
                </button>
            }

            @if (Imposters.Count > 0 && showResult)
            {
                <div class="result-reveal-box">
                    <span class="result-label">@L.ResultImposterHeader(Imposters.Count)</span>

                    <div class="result-imposters-grid">
                        @foreach (var imposter in Imposters)
                        {
                            <div class="result-imposter-item">
                                @if (!string.IsNullOrEmpty(imposter.Uri))
                                {
                                    <img src="@imposter.Uri" alt="@imposter.Name" />
                                }
                                <span class="result-imposter-name">@imposter.Name</span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(SecretWord))
                    {
                        <div class="result-word-pill">@L.ResultSecretWord(SecretWord)</div>
                    }

                    @if (!string.IsNullOrEmpty(SecretCategoryName))
                    {
                        <div class="result-category">@SecretCategoryIcon @SecretCategoryName • @L.DifficultyLabel(SecretDifficulty)</div>
                    }
                </div>
            }

            <button type="button" class="primary-action-btn" @onclick="StartAgain">
                @L.NewRoundButton
            </button>
        </div>
    </div>
</div>
