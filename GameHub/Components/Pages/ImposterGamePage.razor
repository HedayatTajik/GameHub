@page "/impostergame"
@inherits ImposterGame.Pages.ImposterGamePage
<PageTitle>@L.AppTitle</PageTitle>

<NavigationLock ConfirmExternalNavigation="@ShouldConfirmExit"
                OnBeforeInternalNavigation="@HandleBeforeInternalNavigation" />

@if (!gameStarted || CurrentPlayer is null)
{
    <div class="lobby-layout">
        <!-- Quick Settings Summary Bar -->
        <button type="button" class="settings-summary-bar lobby-span-full" @onclick="OpenSettingsDialog">
            <span class="settings-summary-text">@SettingsSummary</span>
            <span class="settings-summary-cta">@L.ChangeButton</span>
        </button>

        <!-- Players Roster Card -->
        <div class="game-card lobby-players-card">
            <div class="section-header-row">
                <span class="section-title">@L.PlayersTitle</span>
                <span class="count-pill">@L.PlayersCountBadge(players.Count)</span>
            </div>

            @if (players.Any(p => !string.IsNullOrEmpty(p.Name)))
            {
                <div class="player-list">
                    @foreach (var player in players)
                    {
                        @if (!string.IsNullOrEmpty(player.Name))
                        {
                            <div class="player-row">
                                <img src="@player.Uri" alt="@player.Name" class="player-avatar" />
                                <span class="player-name">@player.Name</span>
                                <button type="button"
                                        class="player-remove-btn"
                                        aria-label="@L.RemovePlayerAria(player.Name)"
                                        @onclick="() => RemovePlayer(player)">
                                    ✕
                                </button>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="empty-players-box">
                    @L.EmptyPlayersLine1<br />
                    @L.EmptyPlayersLine2
                </div>
            }

            @if (players.Count >= ImposterGame.Services.GameService.MinPlayers)
            {
                <button type="button" class="success-action-btn" @onclick="AssignRoles">
                    @L.StartGameWithCount(players.Count)
                </button>
            }
            else
            {
                var remaining = ImposterGame.Services.GameService.MinPlayers - players.Count;
                var pct = (int)Math.Round(players.Count * 100.0 / ImposterGame.Services.GameService.MinPlayers);
                <div class="min-players-progress">
                    <span class="min-players-text">
                        @L.NeedMorePlayers(remaining, players.Count, ImposterGame.Services.GameService.MinPlayers)
                    </span>
                    <div class="progress-track">
                        <div class="progress-fill" style="@($"width:{pct}%;")"></div>
                    </div>
                </div>
            }
        </div>

        <!-- Add New Player Card -->
        <div class="game-card lobby-add-card">
            <div class="section-title">@L.AddNewPlayerTitle</div>

            <div class="add-player-row">
                <RadzenTextBox Value="@newPlayer.Name"
                               ValueChanged="@OnNameChanged"
                               Immediate="true"
                               @onkeydown="HandleKeyDown"
                               Placeholder="@L.PlayerNamePlaceholder"
                               class="add-player-input" />

                <button type="button"
                        class="add-player-btn"
                        aria-label="@L.AddPlayerAria"
                        @onclick="AddPlayer">
                    ＋
                </button>
            </div>

            @if (!string.IsNullOrEmpty(validationMessage))
            {
                <div class="validation-text">@validationMessage</div>
            }

            <SelectAvatar AfterSelectAvatar="@selectedAvatar"
                          UsedAvatars="@players.Select(p => p.Uri)"
                          OnAvatarSelected="@HandleAvatarSelected" />
        </div>
    </div>
}
else
{
    var revealPct = (int)Math.Round((currentIndex + 1) * 100.0 / Math.Max(1, GameService.Players.Count));
    <div class="stage-container page-stack">
        <div class="game-card reveal-card">
            <div class="reveal-progress-wrap">
                <span class="progress-pill">@L.PlayerProgress(currentIndex + 1, GameService.Players.Count)</span>
                <div class="progress-track">
                    <div class="progress-fill" style="@($"width:{revealPct}%;")"></div>
                </div>
            </div>

            <img src="@CurrentPlayer.Uri" alt="@CurrentPlayer.Name" class="reveal-avatar" />

            <div class="reveal-player-name">@CurrentPlayer.Name</div>

            <!-- Hold-to-Reveal Card Area (fixed min-height prevents layout jump while holding) -->
            @if (isHoldingCard)
            {
                <div class="card-reveal-box @(CurrentPlayer.IsImposter ? "imposter" : "word")">
                    @if (!CurrentPlayer.IsImposter && !string.IsNullOrEmpty(GameService.CurrentCategoryName))
                    {
                        <div class="reveal-category-tag">@GameService.CurrentCategoryIcon @GameService.CurrentCategoryName</div>
                    }

                    <div class="reveal-main-text">@CardText</div>

                    @if (CurrentPlayer.IsImposter)
                    {
                        @if (Settings.ShowCategoryHintToImposter && !string.IsNullOrEmpty(GameService.CurrentCategoryName))
                        {
                            <div class="imposter-hint-badge">
                                @L.ImposterCategoryHint(GameService.CurrentCategoryIcon, GameService.CurrentCategoryName)
                            </div>
                        }

                        <div class="imposter-extra-note">
                            @(GameService.ActiveImposterCount > 1
                                ? L.ImposterTipMulti(GameService.ActiveImposterCount)
                                : L.ImposterTipSingle)
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="mystery-card-back @(CurrentPlayer.HasViewedCard ? "seen" : string.Empty)">
                    <span class="mystery-card-icon">@(CurrentPlayer.HasViewedCard ? "✅" : "🔒")</span>
                    <span class="mystery-card-title">
                        @(CurrentPlayer.HasViewedCard ? L.MysteryCardSeenTitle : L.MysteryCardTitle)
                    </span>
                    <span class="mystery-card-hint">
                        @(CurrentPlayer.HasViewedCard ? L.HoldAgainHint : L.MysteryCardHint(CurrentPlayer.Name))
                    </span>
                </div>
            }

            <!-- Press & Hold Button -->
            <button type="button"
                    class="hold-reveal-btn @(isHoldingCard ? "holding" : string.Empty)"
                    @onpointerdown="StartHoldCard"
                    @onpointerup="EndHoldCard"
                    @onpointerleave="EndHoldCard"
                    @onpointercancel="EndHoldCard"
                    @onkeydown="HandleHoldKeyDown"
                    @onkeyup="HandleHoldKeyUp"
                    @oncontextmenu:preventDefault="true">
                @(isHoldingCard ? L.HoldingButton : L.HoldToRevealButton)
            </button>

            @if (CurrentPlayer.HasViewedCard && !isHoldingCard)
            {
                @if (currentIndex >= GameService.Players.Count - 1)
                {
                    <button type="button" class="success-action-btn" @onclick="StartGame">
                        @L.StartTimerButton
                    </button>
                }
                else
                {
                    <button type="button" class="primary-action-btn" @onclick="NextPlayer">
                        @L.NextPlayerButton
                    </button>
                }
            }

            <button type="button" class="ghost-action-btn" @onclick="CancelGame">
                @L.BackToLobbyButton
            </button>
        </div>
    </div>
}
