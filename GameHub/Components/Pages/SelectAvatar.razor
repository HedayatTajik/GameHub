@inherits ImposterGame.Pages.SelectAvatar

<div>
    <div class="avatar-picker-label">انتخاب آواتار:</div>
    <div class="avatar-grid">
        @foreach (var avatar in Avatars)
        {
            <button type="button"
                    class="@GetAvatarCssClass(avatar)"
                    aria-label="انتخاب آواتار"
                    @onclick="() => SelectAvatarFunc(avatar)">
                <img src="@avatar" alt="آواتار" loading="lazy" />
            </button>
        }
    </div>
</div>
