@implements IDisposable
@inject DialogService DialogService
@inject ImposterGame.Services.GameService GameService
@inject ImposterGame.Services.LocalizationService L
@inject ImposterGame.Services.AudioHapticService AudioHaptic
@inject NavigationManager NavigationManager

<header class="app-topbar">
    <div class="topbar-inner">
        <div class="topbar-start">
            <button type="button"
                    class="icon-btn mobile-only"
                    aria-label="@L.NavMenuLabel"
                    aria-expanded="@(!collapseNavMenu)"
                    @onclick="ToggleNavMenu">
                @(collapseNavMenu ? "☰" : "✕")
            </button>

            <a class="brand-link" href="/" @onclick="CloseNavMenu">
                <span class="brand-icon">🎭</span>
                <span class="brand-title">@L.AppTitle</span>
            </a>
        </div>

        <nav class="desktop-nav" aria-label="@L.NavMenuLabel">
            <NavLink class="desktop-nav-link" href="" Match="NavLinkMatch.All">@L.NavHome</NavLink>
            <NavLink class="desktop-nav-link" href="impostergame">@L.NavGame</NavLink>
            <NavLink class="desktop-nav-link" href="aboutgame">@L.NavAbout</NavLink>
        </nav>

        <div class="topbar-end">
            @if (AudioHaptic.CanInstallPwa && ShowSettingsButton)
            {
                <button type="button"
                        class="icon-btn"
                        aria-label="@L.InstallAppButton"
                        title="@L.InstallAppButton"
                        @onclick="InstallPwa">
                    📲
                </button>
            }

            <button type="button"
                    class="icon-btn"
                    aria-label="@L.ToggleDarkModeLabel"
                    title="@L.ToggleDarkModeLabel"
                    @onclick="ToggleDarkMode">
                @(GameService.Settings.DarkMode ? "☀️" : "🌙")
            </button>

            @if (ShowSettingsButton)
            {
                <button type="button"
                        class="settings-trigger-btn"
                        aria-label="@L.NavSettingsTitle"
                        title="@L.NavSettingsTitle"
                        @onclick="OpenSettingsDialog">
                    <span class="settings-icon">⚙️</span>
                    <span class="settings-label">@L.NavSettings</span>
                </button>
            }
        </div>
    </div>
</header>

@if (!collapseNavMenu)
{
    <div class="mobile-nav-backdrop" @onclick="CloseNavMenu"></div>
    <nav class="mobile-nav-drawer" aria-label="@L.NavMenuLabel">
        <NavLink class="mobile-nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
            <span>🏠</span>
            <span>@L.NavHome</span>
        </NavLink>
        <NavLink class="mobile-nav-link" href="impostergame" @onclick="CloseNavMenu">
            <span>🎭</span>
            <span>@L.NavGame</span>
        </NavLink>
        <NavLink class="mobile-nav-link" href="aboutgame" @onclick="CloseNavMenu">
            <span>📖</span>
            <span>@L.NavAbout</span>
        </NavLink>
        @if (AudioHaptic.CanInstallPwa && ShowSettingsButton)
        {
            <button type="button" class="mobile-nav-link mobile-nav-action" @onclick="InstallPwaFromMenu">
                <span>📲</span>
                <span>@L.InstallAppShort</span>
            </button>
        }
        @if (ShowSettingsButton)
        {
            <button type="button" class="mobile-nav-link mobile-nav-action" @onclick="OpenSettingsFromMenu">
                <span>⚙️</span>
                <span>@L.NavSettings</span>
            </button>
        }
    </nav>
}

@code {
    private bool collapseNavMenu = true;

    private bool IsTimerRoute
    {
        get
        {
            var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var path = relative.Split('?', '#')[0].Trim('/');
            return path.Equals("timer", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool ShowSettingsButton => !GameService.IsGameInProgress && !IsTimerRoute;

    protected override void OnInitialized()
    {
        GameService.OnGameStateChanged += HandleStateChanged;
        GameService.OnSettingsChanged += HandleStateChanged;
        AudioHaptic.OnPwaStateChanged += HandleStateChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GameService.LoadSettingsAsync();
            await AudioHaptic.EnsurePwaSubscribedAsync();
            StateHasChanged();
        }
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        collapseNavMenu = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
    }

    private async Task ToggleDarkMode()
    {
        await GameService.ToggleDarkModeAsync();
    }

    private async Task InstallPwa()
    {
        await AudioHaptic.PromptInstallPwaAsync();
    }

    private async Task InstallPwaFromMenu()
    {
        collapseNavMenu = true;
        await AudioHaptic.PromptInstallPwaAsync();
    }

    private async Task OpenSettingsFromMenu()
    {
        collapseNavMenu = true;
        await OpenSettingsDialog();
    }

    private async Task OpenSettingsDialog()
    {
        await DialogService.OpenAsync<GameHub.Components.Pages.GameSettingsDialog>(
            L.NavSettingsTitle,
            options: ImposterGame.Pages.GameSettingsDialog.CreateDialogOptions());
    }

    public void Dispose()
    {
        GameService.OnGameStateChanged -= HandleStateChanged;
        GameService.OnSettingsChanged -= HandleStateChanged;
        AudioHaptic.OnPwaStateChanged -= HandleStateChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
