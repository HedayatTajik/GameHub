<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="بازی شیاد" />
    <base href="/" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="Icons/apple-touch-icon.png" />
    <script>
        (function () {
            try {
                var raw = localStorage.getItem('ImposterGameSettings');
                if (!raw) return;
                var s = JSON.parse(raw);
                var dark = !!s.DarkMode;
                var lang = (s.Language || 'fa').toLowerCase();
                if (lang !== 'de' && lang !== 'en') lang = 'fa';
                var dir = lang === 'fa' ? 'rtl' : 'ltr';
                var root = document.documentElement;
                root.setAttribute('data-theme', dark ? 'dark' : 'light');
                root.setAttribute('lang', lang);
                root.setAttribute('dir', dir);
                var meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute('content', dark ? '#13111C' : '#FAF7F2');
            } catch (e) { }
        })();
    </script>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lalezar&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GameHub.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="Icons/pwa-192.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <RadzenTheme Theme="material" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="js/gameHub.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
